# Copy to config.local.env (gitignored) and set the values for this machine.
#
#   cp config.example.env config.local.env

# Absolute path of this team's private skills vault.
# CURSOR_SKILLS_VAULT="$HOME/cursor-skills"

# Git URL used by setup when that path does not exist yet.
# CURSOR_SKILLS_VAULT_URL="git@github.com:my-org/cursor-skills.git"

# Engine checkout. Defaults to this repository.
# CURSOR_SKILLS_ENGINE="/absolute/path/to/cursor-skills-vault"

# Reported by status. ssh or https.
# CURSOR_SKILLS_GIT_TRANSPORT=ssh
